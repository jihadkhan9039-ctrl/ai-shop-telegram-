# ============================================================
# TELEGRAM BOT CONFIG
# ============================================================
# Get this from @BotFather
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your numeric Telegram user ID (get it from @userinfobot).
# Only this ID can access /adminpanel
ADMIN_ID=123456789

# Admin's Telegram @username shown to users for support (no @ needed, or include it)
ADMIN_USERNAME=YourSupportUsername

# Public bot username WITHOUT @ (used to build referral links: t.me/<BOT_USERNAME>?start=REF_CODE)
BOT_USERNAME=YourBotUsername

# ============================================================
# FORCE-JOIN CHANNELS (exactly 4)
# Use the numeric channel id (-100xxxxxxxxxx) if the channel is private,
# or the @channelusername if it's public. The bot MUST be an admin
# in each of these channels to call getChatMember.
# ============================================================
CHANNEL_1=@YourChannel1
CHANNEL_2=@YourChannel2
CHANNEL_3=@YourChannel3
CHANNEL_4=@YourChannel4

# Invite links shown to the user for each channel above (same order)
CHANNEL_1_LINK=https://t.me/YourChannel1
CHANNEL_2_LINK=https://t.me/YourChannel2
CHANNEL_3_LINK=https://t.me/YourChannel3
CHANNEL_4_LINK=https://t.me/YourChannel4

# ============================================================
# REFERRAL SYSTEM
# ============================================================
REFERRAL_BONUS=5
REFERRAL_HOLD_HOURS=24

# ============================================================
# FIREBASE (Firestore) - Service Account credentials
# Generate from Firebase Console > Project Settings > Service Accounts
# > Generate New Private Key. Paste the values below (keep the \n in
# FIREBASE_PRIVATE_KEY exactly as they appear, wrapped in quotes).
# ============================================================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ============================================================
# EXPRESS / SMS WEBHOOK SERVER
# ============================================================
PORT=3000
# Shared secret the Android SMS Forwarder app must send in
# header "x-webhook-secret" to authenticate itself.
SMS_WEBHOOK_SECRET=change-this-to-a-long-random-string
